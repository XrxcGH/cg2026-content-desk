node_modules/
dist/

# Event logs — one NDJSON per session. Keep the ones worth replaying.
data/events/*.ndjson
!data/events/sample.ndjson

# Team media library. Robot cutouts are large and event-specific; the
# manifest is regenerated from disk on boot.
media/teams/*/
media/manifest.json

# Rolling record scratch — 4 cams x 1080p60 is ~22GB/hour. Never commit.
rec/

config.json
*.log
